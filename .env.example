# COPY to .env in the project root. Do not commit the real .env file.
# Generate 3 independent random values before going live.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_ROOT_PASSWORD
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
INTERNAL_API_TOKEN=REPLACE_WITH_LONG_RANDOM_64_CHARACTER_TOKEN
WEB_PORT=8080
# Set to 1 only behind a correctly configured HTTPS reverse proxy.
APP_FORCE_HTTPS=0
