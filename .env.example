# COPY to .env in the project root. Do not commit the real .env file.
# Generate 3 independent random values before going live.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_ROOT_PASSWORD
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
INTERNAL_API_TOKEN=REPLACE_WITH_LONG_RANDOM_64_CHARACTER_TOKEN
WEB_PORT=8080
# Set to 1 only behind a correctly configured HTTPS reverse proxy.
APP_FORCE_HTTPS=0
# Canonical external application URL, used for verification/reset links.
APP_URL=http://localhost:8080
# PHP mail() must have a configured transport before enabling email.
MAIL_ENABLED=0
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=0
COUNSELLING_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
SUPPORT_EMAIL=
# Optional JSON weight override in AI runtime; defaults documented in method config.
# RECOMMENDATION_WEIGHTS={"interest":0.60,"academic":0.20,"subjects":0.10,"aspirations":0.05,"skills":0.025,"preferences":0.025}
